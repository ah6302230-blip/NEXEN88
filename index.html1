<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><title>NEXEN</title>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<style>
:root{color-scheme:dark;--bg:#0a0a0a;--sf:#141414;--tx:#ededed;--mu:#8a8a8a;--ln:#262626;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*{box-sizing:border-box}html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--tx);font-family:"Segoe UI",Tahoma,Arial,sans-serif}
a{color:inherit;text-decoration:none}
.bar{background:#ededed;color:#000;text-align:center;font-size:12px;padding:8px 10px;letter-spacing:.04em}
header{display:flex;align-items:center;gap:14px;padding:14px 22px;border-bottom:1px solid var(--ln)}
.logo{letter-spacing:.45em;font-weight:300;font-size:20px}
.srch{flex:1;max-width:460px;margin:0 auto;background:var(--sf);border:1px solid var(--ln);color:var(--tx);padding:10px 14px;font:inherit;font-size:14px}
.cartb{border:1px solid var(--ln);padding:9px 14px;font-size:14px;white-space:nowrap}
.nv{display:flex;justify-content:center;gap:6px;border-bottom:1px solid var(--ln);padding:0 12px;overflow-x:auto;position:sticky;top:env(safe-area-inset-top,0px);background:var(--bg);z-index:5}
.nv>a,.dd>a{display:block;padding:14px 16px;font-size:14px;white-space:nowrap}.nv a:hover{color:#fff;background:var(--sf)}
.dd{position:relative}.menu{display:none;position:absolute;inset-inline-start:0;top:100%;min-width:160px;background:var(--sf);border:1px solid var(--ln);z-index:9}
.menu a{display:block;padding:11px 16px;font-size:14px}@media(hover:hover){.dd:hover .menu{display:block}}
.btn{display:inline-block;background:none;border:1px solid var(--ln);color:var(--tx);padding:9px 16px;cursor:pointer;font:inherit;font-size:14px;text-align:center}
.btn.p{background:var(--tx);color:#000;border-color:var(--tx)}.btn:hover{border-color:#777}.blk{display:block;width:100%}
.hero{width:100%;aspect-ratio:873/1088;background:#000 center/100% 100% no-repeat}
.ht{text-align:center;padding:30px 12px 0}.ht h1{margin:0 0 8px;font-weight:200;letter-spacing:.5em;font-size:clamp(28px,6vw,56px)}.ht p{margin:0;letter-spacing:.3em;font-size:12px;color:#bbb}
.feat{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--ln);margin-top:34px;border-block:1px solid var(--ln)}
.feat div{background:var(--bg);padding:20px 10px;text-align:center;font-size:13px;color:var(--mu)}.feat b{display:block;color:var(--tx);font-weight:400;margin-bottom:4px;font-size:14px}
main{max-width:1100px;margin:0 auto;padding:34px 18px 70px}
h2{font-weight:300;letter-spacing:.25em;font-size:15px;color:var(--mu);margin:0 0 22px}
.tiles{display:grid;gap:14px}.tiles.two{grid-template-columns:repeat(2,1fr)}.tiles.three{grid-template-columns:repeat(3,1fr)}
.tile{position:relative;aspect-ratio:4/5;background:#000 center/cover;display:block;overflow:hidden}
.tile:after{content:"";position:absolute;inset:0;background:linear-gradient(transparent 55%,rgba(0,0,0,.85))}
.tile span{position:absolute;bottom:16px;inset-inline:0;text-align:center;z-index:2;letter-spacing:.2em;font-size:18px;font-weight:300}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:18px}
.card{background:var(--sf);border:1px solid var(--ln)}.card .im{aspect-ratio:4/5;background:#000 center/cover}
.card .in{padding:14px}.nm{font-size:15px;display:block}.pr{color:var(--mu);margin:4px 0 10px;font-size:14px}
.dots{display:flex;gap:7px;margin-bottom:10px;flex-wrap:wrap}.dot{width:20px;height:20px;border-radius:50%;border:2px solid var(--ln);cursor:pointer}.dot.on{outline:2px solid #fff;outline-offset:2px}.card .dot{width:14px;height:14px;cursor:default}
.th{display:flex;gap:5px;margin-bottom:10px}.th i{width:30px;height:30px;background:center/cover;border:1px solid var(--ln);cursor:pointer;display:block}.th i.on{border-color:#fff}
.empty{border:1px dashed var(--ln);padding:60px 20px;text-align:center;color:var(--mu);letter-spacing:.1em}
.crumb{font-size:13px;color:var(--mu);margin-bottom:18px}.crumb a:hover{color:#fff}
.tb{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin:14px 0 22px}
.chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px}.chip{border:1px solid var(--ln);padding:7px 14px;font-size:13px}.chip.on{background:var(--tx);color:#000}
select{background:var(--sf);color:var(--tx);border:1px solid var(--ln);padding:9px;font:inherit;font-size:14px;margin-bottom:10px}
.row{display:flex;gap:12px;align-items:center;padding:12px 0;border-bottom:1px solid var(--ln)}.row .t{width:56px;height:56px;background:#000 center/cover;flex:none}.row .g{flex:1;font-size:14px}
input,textarea{width:100%;background:var(--sf);border:1px solid var(--ln);color:var(--tx);padding:11px;font:inherit;margin-bottom:10px}
.box{max-width:560px;margin:0 auto}.q button{width:28px;height:28px;background:var(--sf);border:1px solid var(--ln);color:var(--tx);cursor:pointer}
.mut{color:var(--mu);font-size:13px}.x{color:#e66;background:none;border:0;cursor:pointer;font:inherit}
.cr{display:flex;gap:8px;align-items:center;margin-bottom:8px}.cr input{margin:0}.cr input[type=color]{width:46px;padding:2px;height:40px}
.pg{display:grid;grid-template-columns:1fr 1fr;gap:34px}.mainimg{aspect-ratio:4/5;background:#000 center/cover}
.sz{display:flex;gap:8px;margin:8px 0 20px;flex-wrap:wrap}.sz span{min-width:46px;text-align:center;padding:10px 12px;border:1px solid var(--ln);cursor:pointer}.sz span.on{background:var(--tx);color:#000}
footer{border-top:1px solid var(--ln);padding:36px 22px 20px;margin-top:20px}.fg{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:2fr 1fr 1fr;gap:28px;font-size:13px;color:var(--mu)}
.fg b{display:block;color:var(--tx);font-weight:400;margin-bottom:10px;letter-spacing:.15em}.fg a,.fg p{display:block;margin:0 0 7px}.fg a:hover{color:#fff}.cp{text-align:center;font-size:12px;color:var(--mu);margin-top:26px}
.card{transition:transform .35s ease,border-color .35s}.card:hover{transform:translateY(-5px);border-color:#555}.card>a{display:block;overflow:hidden}.card .im{transition:transform .7s cubic-bezier(.2,.7,.2,1)}.card:hover .im{transform:scale(1.09)}
.tile:before{content:"";position:absolute;inset:0;background:inherit;transition:transform .8s cubic-bezier(.2,.7,.2,1)}.tile:hover:before{transform:scale(1.1)}.tile span{transition:transform .5s,letter-spacing .5s}.tile:hover span{transform:translateY(-8px);letter-spacing:.32em}
.mw{overflow:hidden}.mainimg{transition:transform .8s cubic-bezier(.2,.7,.2,1)}.mw:hover .mainimg{transform:scale(1.07)}
.th i{transition:transform .25s,border-color .25s}.th i:hover{transform:scale(1.12);border-color:#aaa}
.hero{transition:background-size 1.2s ease}.hero:hover{background-size:106% 106%}
@media(prefers-reduced-motion:reduce){*,*:before{transition:none!important}}
.dh{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:18px;flex-wrap:wrap}
.dtabs{display:flex;background:var(--sf);border:1px solid var(--ln);margin:0 0 22px}
.dtabs button{flex:1;background:none;border:0;border-bottom:2px solid transparent;color:var(--mu);padding:12px 4px;font:inherit;font-size:12px;cursor:pointer}.dtabs button span{display:block;font-size:20px}.dtabs button.on{color:#fff;border-bottom-color:#fff}
.sg{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-bottom:24px}.sc2{background:var(--sf);border:1px solid var(--ln);padding:16px}.sc2 b{display:block;font-size:24px;font-weight:300;margin-bottom:4px}.sc2 span{color:var(--mu);font-size:13px}
.oc{background:var(--sf);border:1px solid var(--ln);padding:14px;margin-bottom:12px;display:grid;gap:7px;font-size:14px}.oh{display:flex;justify-content:space-between;gap:8px;align-items:center}
.tag{font-size:12px;padding:3px 10px;border:1px solid var(--ln)}.st-new{background:#fff;color:#000}.st-shipped{border-color:#7ab}.st-done{border-color:#7b7}.st-cancelled{border-color:#a66;color:#a66}
.it{display:flex;gap:10px;align-items:center;font-size:13px}.it i{width:46px;height:46px;background:#000 center/cover;flex:none}
.of{display:flex;gap:10px;align-items:center;justify-content:space-between;margin-top:6px}.of select{margin:0}.bar2{height:8px;background:var(--ln)}
.pm{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.pmo{border:1px solid var(--ln);padding:12px 8px;display:flex;flex-direction:column;align-items:center;gap:8px;cursor:pointer;background:#000;font-size:13px;text-align:center;min-height:84px;justify-content:center}.pmo.on{border-color:#fff;outline:1px solid #fff}
.codb{letter-spacing:.3em;font-size:10px;font-weight:300;color:#d8c39a;border-top:1px solid #d8c39a;border-bottom:1px solid #d8c39a;padding:6px 10px;white-space:nowrap}
.lgc{width:76px;height:76px;border-radius:50%;overflow:hidden;display:flex;align-items:center;justify-content:center;background:#fff;flex:none}.lgc img{width:100%;height:100%;object-fit:contain;display:block}.lgc.tx{background:#111;color:#fff;font-size:13px;font-weight:600;border:1px solid #333;text-align:center;line-height:1.2;padding:6px}
.pb{display:inline-block;font-size:15px;font-weight:600;letter-spacing:.02em;color:#fff}
.pt{display:grid;grid-template-columns:1fr 1fr;gap:10px}.pto{border:1px solid var(--ln);background:#000;padding:20px 8px;text-align:center;cursor:pointer;font-size:15px}.pto.on{border-color:#fff;outline:1px solid #fff}
.pp{border:1px solid var(--ln);background:var(--sf);padding:16px;margin:14px 0}.amt{font-size:30px;font-weight:300;margin:4px 0 14px}.acc{display:flex;gap:10px;align-items:center;font-size:18px;direction:ltr;justify-content:space-between}
.rp{max-width:100%;max-height:260px;margin-top:10px;border:1px solid var(--ln)}.lb{display:block;margin-bottom:14px}.lb input{width:auto;margin:0 0 0 8px}
@media(max-width:760px){.pg,.fg{grid-template-columns:1fr}.tiles.three{grid-template-columns:repeat(2,1fr)}header{flex-wrap:wrap}.srch{order:3;flex-basis:100%;max-width:none}.nv{justify-content:flex-start}.menu{display:none!important}}
</style></head><body><div id="app"></div>
<script id="state" type="application/json">{"brand": "NEXEN", "email": "diriciejedj@gmail.com", "pw": "98dfb77df933bc4bb7f1b956d81e40b9551b27dab741f670e5c5f6c19d96dec8", "products": [{"id": "pmv7sa6i2", "name": "ععي", "price": 4440, "colors": [{"name": "أسود", "hex": "#000000"}], "images": ["data:image/jpeg;base64,"]}], "pay": {"cod": true, "whatsapp": "", "m": {"instapay": {"on": true, "account": "ahmed_hatem99@instapay", "name": "", "logo": "data:image/png;base64,", "alt": "01032786583", "qr": "data:image/jpeg;base64,"}, "vodafone": {"on": true, "account": "01032786583", "name": "", "logo": "data:image/jpeg;base64,"}, "telda": {"account": "@ahmedhatem823489", "name": "", "logo": "data:image/jpeg;base64,", "on": true, "alt": "01032786583", "qr": "data:image/jpeg;base64,"}}}}</script>
<script>
const BANNER="data:image/jpeg;base64,",TILES={"men": "data:image/jpeg;base64,", "women": "data:image/jpeg;base64,", "hoodie": "data:image/jpeg;base64,", "jeans": "data:image/jpeg;base64,", "pants": "data:image/jpeg;base64,"};
const S=JSON.parse(document.getElementById('state').textContent);
function persist(){try{localStorage.setItem('nx_local',JSON.stringify({ver:S.ver||0,products:S.products,pay:S.pay}))}catch(e){}}
try{const L=JSON.parse(localStorage.getItem('nx_local')||'null');if(L&&L.ver===(S.ver||0)){S.products=L.products;if(L.pay)S.pay=L.pay}}catch(e){}
S.pay=S.pay||{};{const PD=(o,k)=>Object.assign({on:true,account:'',name:'',logo:''},o&&o[k]);S.pay={cod:S.pay.cod!==false,whatsapp:S.pay.whatsapp||'',m:{vodafone:PD(S.pay.m,'vodafone'),instapay:PD(S.pay.m,'instapay'),telda:PD(S.pay.m,'telda')}}}
const PM={cod:{n:'الدفع عند الاستلام',en:'COD',c:'#333'},vodafone:{n:'فودافون كاش',en:'Vodafone Cash',c:'#e60000'},instapay:{n:'إنستا باي',en:'InstaPay',c:'#5b2a86'},telda:{n:'تيلدا',en:'Telda',c:'#1a1a1a'}};
let pm='cod',pt='cod',receipt='',receiptFile=null;
const avail=()=>{const a=[];if(S.pay.cod)a.push('cod');['vodafone','instapay','telda'].forEach(k=>{if(S.pay.m[k].on)a.push(k)});return a};
const badge=k=>k==='cod'?'':(S.pay.m[k].logo?`<span class="lgc"><img src="${S.pay.m[k].logo}" alt=""></span>`:`<span class="lgc tx">${PM[k].en}</span>`);
const pp=()=>{try{persist()}catch(e){}render()};
function imgProc(f,max,type,q){return new Promise(r=>{const i=new Image,u=URL.createObjectURL(f);i.onload=()=>{const k=Math.min(1,max/Math.max(i.width,i.height)),c=document.createElement('canvas');c.width=i.width*k;c.height=i.height*k;c.getContext('2d').drawImage(i,0,0,c.width,c.height);URL.revokeObjectURL(u);const url=c.toDataURL(type,q);c.toBlob(b=>r({url,file:new File([b],type==='image/png'?'logo.png':'receipt.jpg',{type})}),type,q)};i.src=u})}

const G={men:'رجالي',women:'نسائي'},T={hoodie:'هوديز'};
const $=s=>document.querySelector(s),esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const money=n=>Number(n).toLocaleString('ar-EG')+' ج.م';
function route(h=location.hash.slice(1)){const p=h.split('/');return{v:h==='done'?'done':h==='admin'?'login':h==='cart'?'cart':h==='checkout'?'co':p[0]==='p'?'prod':p[0]==='c'?'col':'home',a:p[1]||'all',b:p[2]||'all'}}
let R=route(),unlocked=false,qs='',keepQ=false,sort='new',cart=[],sel={},img={},ssz={},co={};
try{cart=JSON.parse(localStorage.getItem('nx_cart')||'[]')}catch(e){}
try{unlocked=sessionStorage.getItem('nx_u')==='1'}catch(e){}
const save=()=>{try{localStorage.setItem('nx_cart',JSON.stringify(cart))}catch(e){}};
const total=()=>cart.reduce((a,i)=>a+i.price*i.qty,0),count=()=>cart.reduce((a,i)=>a+i.qty,0);
const sha=async s=>[...new Uint8Array(await crypto.subtle.digest('SHA-256',new TextEncoder().encode(s)))].map(b=>b.toString(16).padStart(2,'0')).join('');
const label=p=>[G[p.gender],T[p.type]].filter(Boolean).join(' · ');
function render(){let v=R.v;if(v==='login'&&unlocked)v='dash';
 const V={home,col,prod:prodPage,cart:cartV,co:coV,done:doneV,login:loginV,dash};
 $('#app').innerHTML=head()+V[v]()+(v==='dash'?'':foot())}
history.scrollRestoration='manual';
function nav(h,q=''){try{history.replaceState({...history.state,y:scrollY},'')}catch(e){}R=route(h);qs=q;const st={h,q};try{history.pushState(st,'','#'+h)}catch(e){try{history.pushState(st,'')}catch(e2){}}render();scrollTo(0,0)}
try{history.replaceState({h:location.hash.slice(1),q:''},'')}catch(e){}
addEventListener('popstate',e=>{const s=e.state||{h:location.hash.slice(1),q:''};R=route(s.h);qs=s.q||'';render();scrollTo(0,s.y||0)});
document.addEventListener('click',e=>{const a=e.target.closest('a[href^="#"]');if(!a||e.metaKey||e.ctrlKey)return;e.preventDefault();nav(a.getAttribute('href').slice(1))});
function head(){return `<header><a class="logo" href="#">${esc(S.brand)}</a><input id="q" class="srch" placeholder="ابحث عن منتج..." value="${esc(qs)}"><a class="cartb" href="#cart">🛒 السلة (${count()})</a></header>
<nav class="nv"><a href="#c/all/all">الكل</a>${Object.keys(G).map(g=>`<div class="dd"><a href="#c/${g}/all">${G[g]}</a><div class="menu">${Object.keys(T).map(t=>`<a href="#c/${g}/${t}">${T[t]}</a>`).join('')}<a href="#c/${g}/all">كل ${G[g]}</a></div></div>`).join('')}${Object.keys(T).map(t=>`<a href="#c/all/${t}">${T[t]}</a>`).join('')}</nav>`}
function foot(){return `<footer><div class="fg"><div><b>${esc(S.brand)}</b><p>MORE THAN CLOTHES · IT'S A MINDSET</p></div>
<div><b>تسوق</b><a href="#c/men/all">رجالي</a><a href="#c/women/all">نسائي</a><a href="#c/all/hoodie">هوديز</a></div>
<div><b>المساعدة</b><p>استبدال واسترجاع خلال 14 يوم</p><p>الدفع عند الاستلام</p><p>توصيل لجميع المحافظات</p></div></div><div class="cp">© 2026 ${esc(S.brand)}</div></footer><div class="bar">توصيل لجميع المحافظات · استبدال واسترجاع خلال 14 يوم · الدفع عند الاستلام</div>`}
function card(p){return `<div class="card"><a href="#p/${p.id}"><div class="im" style="background-image:url(${p.images[0]||''})"></div></a><div class="in"><a class="nm" href="#p/${p.id}">${esc(p.name)}</a><div class="pr">${money(p.price)}${p.out?' · <b style="color:#e66">نفذت الكمية</b>':''}</div>
<div class="dots">${(p.colors||[]).map(x=>`<span class="dot" title="${esc(x.name)}" style="background:${esc(x.hex)}"></span>`).join('')}</div><a class="btn p blk" href="#p/${p.id}">عرض المنتج</a></div></div>`}
const tile=(h,k,n)=>`<a class="tile" href="#${h}" style="background-image:url(${TILES[k]})"><span>${n}</span></a>`;
function home(){const n=S.products.slice(-8).reverse();
 return `<div class="hero" style="background-image:url(${BANNER})"></div><div class="ht"><h1>${esc(S.brand)}</h1><p>MORE THAN CLOTHES · IT'S A MINDSET</p></div>

<main><h2>تسوق حسب القسم</h2><div class="tiles two">${tile('c/men/all','men','رجالي')}${tile('c/women/all','women','نسائي')}</div>

<h2 style="margin-top:46px">وصل حديثاً</h2>${n.length?`<div class="grid">${n.map(card).join('')}</div>`:`<div class="empty">قريباً · COMING SOON</div>`}
<div style="text-align:center;margin-top:26px"><a class="btn" href="#c/all/all">عرض كل المنتجات</a></div></main><div class="feat" style="margin-top:0"><div><b>توصيل سريع</b>لجميع المحافظات</div><div><b>استبدال واسترجاع</b>خلال 14 يوم</div><div><b>الدفع عند الاستلام</b>بدون أي مخاطرة</div></div>`}
function col(){const g=R.a,t=R.b;let L=S.products.filter(p=>(g==='all'||p.gender===g)&&(t==='all'||p.type===t)&&(!qs||p.name.toLowerCase().includes(qs.toLowerCase())));
 L=L.slice().reverse();if(sort==='lo')L.sort((a,b)=>a.price-b.price);if(sort==='hi')L.sort((a,b)=>b.price-a.price);
 const tt=qs?'نتائج البحث: '+qs:[g!=='all'?G[g]:'',t!=='all'?T[t]:''].filter(Boolean).join(' · ')||'كل المنتجات';
 const ch=(h,on,n)=>`<a class="chip ${on?'on':''}" href="#${h}">${n}</a>`;
 return `<main><div class="crumb"><a href="#">الرئيسية</a> / ${esc(tt)}</div><h2 style="font-size:20px;color:var(--tx)">${esc(tt)}</h2>
<div class="chips">${ch('c/all/'+t,g==='all','الكل')}${Object.keys(G).map(k=>ch(`c/${k}/${t}`,g===k,G[k])).join('')}</div>
<div class="chips">${ch('c/'+g+'/all',t==='all','كل الأنواع')}${Object.keys(T).map(k=>ch(`c/${g}/${k}`,t===k,T[k])).join('')}</div>
<div class="tb"><span class="mut">${L.length} منتج</span><select data-a="sort"><option value="new" ${sort==='new'?'selected':''}>الأحدث</option><option value="lo" ${sort==='lo'?'selected':''}>السعر: الأقل أولاً</option><option value="hi" ${sort==='hi'?'selected':''}>السعر: الأعلى أولاً</option></select></div>
${L.length?`<div class="grid">${L.map(card).join('')}</div>`:`<div class="empty">مفيش منتجات هنا حالياً</div>`}</main>`}
function prodPage(){const p=S.products.find(x=>x.id===R.a);
 if(!p)return `<main><div class="empty">المنتج مش موجود</div><br><a class="btn" href="#">← رجوع للمتجر</a></main>`;
 const c=p.colors||[],si=sel[p.id]??0,im=img[p.id]??0,sz=p.sizes||[],ss=ssz[p.id]??0;
 return `<main><div class="crumb"><a href="#">الرئيسية</a> / ${p.gender?`<a href="#c/${p.gender}/all">${G[p.gender]}</a> / `:''}${T[p.type]?`<a href="#c/all/${p.type}">${T[p.type]}</a> / `:''}${esc(p.name)}</div>
<div class="pg"><div><div class="mw"><div class="mainimg" style="background-image:url(${p.images[im]||''})"></div></div><div class="th" style="margin-top:10px">${p.images.map((s,k)=>`<i class="${k===im?'on':''}" style="width:64px;height:64px;background-image:url(${s})" data-a="im" data-id="${p.id}" data-k="${k}"></i>`).join('')}</div></div>
<div><h1 style="font-weight:300;margin:0 0 8px">${esc(p.name)}</h1><div style="font-size:22px;margin-bottom:24px">${money(p.price)}</div>
${c.length?`<div class="mut">اللون: ${esc((c[si]||{}).name)}</div><div class="dots" style="margin:10px 0 20px">${c.map((x,k)=>`<span class="dot ${k===si?'on':''}" title="${esc(x.name)}" style="background:${esc(x.hex)}" data-a="sc" data-id="${p.id}" data-k="${k}"></span>`).join('')}</div>`:''}
${sz.length?`<div class="mut">المقاس</div><div class="sz">${sz.map((z,k)=>`<span class="${k===ss?'on':''}" data-a="ss" data-id="${p.id}" data-k="${k}">${esc(z)}</span>`).join('')}</div>`:''}
${p.out?'<div class="btn blk" style="padding:15px;color:#e66">نفذت الكمية</div>':`<button class="btn p blk" style="padding:15px" data-a="add" data-id="${p.id}">أضف للسلة</button>`}</div></div>
<div style="margin-top:44px;border-top:1px solid var(--ln);padding-top:24px"><h2>تفاصيل المنتج</h2><p style="white-space:pre-line;line-height:1.9;color:#cfcfcf;max-width:760px">${esc(p.desc||'—')}</p></div></main>`}
function cartV(){return `<main><div class="box"><h2>سلة المشتريات</h2>${cart.length?cart.map((i,k)=>`<div class="row"><div class="t" style="background-image:url(${i.img||''})"></div><div class="g">${esc(i.name)}<div class="mut">${esc(i.color)} · ${money(i.price)}</div></div>
<div class="q"><button data-a="q" data-k="${k}" data-d="1">+</button> ${i.qty} <button data-a="q" data-k="${k}" data-d="-1">−</button></div><button class="x" data-a="rm" data-k="${k}">حذف</button></div>`).join('')+`<p style="font-size:18px">الإجمالي: ${money(total())}</p><a class="btn p" href="#checkout">إتمام الطلب</a>`:`<div class="empty">السلة فاضية</div><br><a class="btn" href="#">متابعة التسوق</a>`}</div></main>`}
function coV(){const f=(k,ph,x='')=>`<input data-f="${k}" placeholder="${ph}" value="${esc(co[k])}" ${x}>`,wal=avail().filter(k=>k!=='cod');
 if(!S.pay.cod&&wal.length&&pt==='cod')pt='online';if(pt==='online'&&!wal.length)pt='cod';if(pt==='online'&&!wal.includes(pm))pm='';
 const m=pt==='online'&&pm?S.pay.m[pm]:null;
 return `<main><div class="box"><h2>بيانات التوصيل</h2>${f('n','الاسم بالكامل')}${f('p','رقم الموبايل','inputmode="tel"')}${f('c','المحافظة / المدينة')}<textarea data-f="a" rows="3" placeholder="العنوان بالتفصيل">${esc(co.a)}</textarea><textarea data-f="m" rows="2" placeholder="ملاحظات (اختياري)">${esc(co.m)}</textarea>
<h2 style="margin-top:26px">طريقة الدفع</h2><div class="pt">${S.pay.cod?`<div class="pto ${pt==='cod'?'on':''}" data-a="pt" data-k="cod">الدفع عند الاستلام</div>`:''}${wal.length?`<div class="pto ${pt==='online'?'on':''}" data-a="pt" data-k="online">الدفع الإلكتروني</div>`:''}</div>
${pt==='online'?`<div class="mut" style="margin:16px 0 8px">اختار المحفظة:</div><div class="pm">${wal.map(k=>`<div class="pmo ${pm===k?'on':''}" data-a="pm" data-k="${k}">${badge(k)}<span>${PM[k].n}</span></div>`).join('')}</div>`:''}
${m?`<div class="pp"><div class="mut">المبلغ المطلوب تحويله</div><div class="amt">${money(total())}</div><div class="mut">حوّل على ${PM[pm].n}:</div>
${m.account?`<div class="acc"><b>${esc(m.account)}</b><button class="btn" data-a="copy" data-v="${esc(m.account)}" style="padding:6px 12px">نسخ</button></div>`:'<div style="color:#e66">رقم التحويل لسه متحددش، كلمنا قبل ما تحوّل</div>'}${m.alt?`<div class="mut" style="margin-top:6px">أو على رقم الموبايل: <b dir="ltr" style="color:#ededed">${esc(m.alt)}</b></div>`:''}${m.iban?`<div class="mut" style="margin-top:12px">أو على رقم الحساب (IBAN):</div><div class="acc" style="font-size:14px"><b style="word-break:break-all">${esc(m.iban)}</b><button class="btn" data-a="copy" data-v="${esc(m.iban)}" style="padding:6px 12px">نسخ</button></div>`:''}${m.name?`<div class="mut" style="margin-top:6px">باسم: ${esc(m.name)}</div>`:''}
${m.qr?`<div style="margin:16px 0;text-align:center"><div class="mut" style="margin-bottom:8px">أو امسح الباركود من تطبيق ${PM[pm].n}</div><img src="${m.qr}" alt="" style="width:230px;max-width:100%;background:#fff;padding:6px;border-radius:8px"><br><a class="btn" style="margin-top:8px;padding:6px 14px" download="${pm}-qr.jpg" href="${m.qr}">حفظ الباركود</a></div>`:''}<div class="mut" style="margin:14px 0 6px">بعد التحويل ارفق صورة التحويل (سكرين شوت):</div><input type="file" accept="image/*" id="rc">${receipt?`<img class="rp" src="${receipt}" alt="">`:''}</div>`:''}
${pt==='cod'?`<div class="pp mut">هتدفع المبلغ ${money(total())} للمندوب وقت الاستلام.</div>`:''}
<p>الإجمالي: ${money(total())}</p><button class="btn p blk" data-a="order">إرسال الطلب</button></div></main>`}
function doneV(){const sh=window._file&&navigator.canShare&&navigator.canShare({files:[window._file]}),w=S.pay.whatsapp.replace(/\D/g,'');
 return `<main><div class="box"><h2>تم تجهيز طلبك ✓</h2><p>خطوة أخيرة: ابعت الطلب${window._pm&&window._pm!=='cod'?' مع صورة التحويل':''} من الزراير دي.</p>
${sh?'<button class="btn p blk" style="margin-bottom:10px" data-a="shr">إرسال مع صورة التحويل (واتساب أو أي تطبيق)</button>':''}
${w?`<a class="btn blk" style="margin-bottom:10px" target="_blank" href="https://wa.me/${w}?text=${encodeURIComponent(window._body||'')}">إرسال على واتساب</a>`:''}
<a class="btn blk" style="margin-bottom:10px" href="${esc(window._mail||'#')}">إرسال بالإيميل</a>
${window._rc?`<p class="mut">لو بعت بالإيميل أو الواتساب العادي، ارفق صورة التحويل بإيدك. احفظها من هنا:</p><img class="rp" src="${window._rc}" alt=""><br><a class="btn" style="margin-top:8px" download="receipt.jpg" href="${window._rc}">حفظ صورة التحويل</a>`:''}
<br><a class="btn" style="margin-top:14px" href="#">رجوع للمتجر</a></div></main>`}
function loginV(){return `<main><div class="box"><h2>دخول الإدارة</h2><input id="lp" type="password" placeholder="الباسورد"><button class="btn p" data-a="login">دخول</button></div></main>`}
let draft={name:'',price:'',desc:'',sizes:'',gender:'men',type:'hoodie',colors:[{name:'أسود',hex:'#000000'}],images:[]};
const opts=(o,v)=>Object.keys(o).map(k=>`<option value="${k}" ${k===v?'selected':''}>${o[k]}</option>`).join('');
let ORD=[],dbx=null,dbState='idle',dtab='prods',showForm=false,showImp=false,editId=null;
const ST={new:'جديد',shipped:'تم الشحن',done:'تم التسليم',cancelled:'ملغي'};
function saveOrd(){try{localStorage.setItem('nx_orders',JSON.stringify(ORD))}catch(e){}}
async function startOrders(){try{ORD=JSON.parse(localStorage.getItem('nx_orders')||'[]')}catch(e){ORD=[]}dbState='ok'}
function parseOrder(t){const g=k=>{const m=t.match(new RegExp('^\\s*'+k+'\\s*[:：]\\s*(.*)$','m'));return m?m[1].trim():''};
 const num=s=>parseInt(String(s||'').replace(/[^\d]/g,''))||0,items=[];
 t.split('\n').forEach(l=>{l=l.trim();if(!/^[-•]/.test(l))return;const p=l.replace(/^[-•]\s*/,'').split('|').map(s=>s.trim());if(p.length<2)return;
  items.push({name:p[0],color:(p[1]||'').replace(/^[^:]*:\s*/,''),qty:num((p[2]||'').split(':').pop())||1,sum:num(p[3]),code:((p[4]||'').split(':').pop()||'').trim()})});
 const tm=t.match(/الإجمالي\s*[:：]\s*([\d.,]+)/),total=tm?num(tm[1]):items.reduce((a,i)=>a+i.sum,0);
 const o={name:g('العميل'),phone:g('الموبايل'),city:g('المدينة'),address:g('العنوان'),notes:g('ملاحظات'),pay:g('طريقة الدفع'),items,total,status:'new',ts:Date.now()};
 return o.name&&o.phone&&items.length?o:null}
function dStats(){const live=ORD.filter(o=>o.status!=='cancelled'),sales=live.reduce((a,o)=>a+(o.total||0),0),cnt=k=>ORD.filter(o=>o.status===k).length;
 const tp={};live.forEach(o=>(o.items||[]).forEach(i=>{tp[i.name]=(tp[i.name]||0)+(i.qty||1)}));const top=Object.entries(tp).sort((a,b)=>b[1]-a[1]).slice(0,5),mx=top.length?top[0][1]:1;
 return `<div class="sg"><div class="sc2"><b>${S.products.length}</b><span>منتج في المتجر</span></div><div class="sc2"><b>${ORD.length}</b><span>إجمالي الطلبات</span></div>
<div class="sc2"><b>${money(sales)}</b><span>إجمالي المبيعات</span></div><div class="sc2"><b>${cnt('new')}</b><span>طلبات جديدة</span></div></div>
<h2>حالة الطلبات</h2><div class="sg">${Object.keys(ST).map(k=>`<div class="sc2"><b>${cnt(k)}</b><span>${ST[k]}</span></div>`).join('')}</div>
<h2>الأكثر مبيعاً</h2>${top.length?top.map(([n,q])=>`<div style="margin-bottom:12px"><div style="display:flex;justify-content:space-between;font-size:14px"><span>${esc(n)}</span><span>${q}</span></div><div class="bar2"><div style="height:8px;background:var(--tx);width:${Math.round(q/mx*100)}%"></div></div></div>`).join(''):'<div class="empty">لسه مفيش مبيعات مسجلة</div>'}
<h2 style="margin-top:30px">الإعدادات</h2><div class="box" style="margin:0"><b>تغيير الباسورد</b><br><br><input id="np" type="password" placeholder="باسورد جديد"><button class="btn" data-a="chpw">تغيير (وبعدها اضغط تصدير الموقع)</button></div>`}
function dProds(){const ed=!!editId;
 return `<button class="btn p blk" data-a="${ed?'dcancel':'dform'}" style="margin-bottom:16px">${ed?'إلغاء التعديل':showForm?'إغلاق':'+ إضافة منتج'}</button>
${showForm?`<div class="box" style="margin:0 0 28px"><b>${ed?'تعديل المنتج':'منتج جديد'}</b><br><br><input id="dn" placeholder="اسم المنتج" value="${esc(draft.name)}"><input id="dp" type="number" placeholder="السعر (ج.م)" value="${esc(draft.price)}">
<select data-a="dsel" data-f="gender">${opts(G,draft.gender)}</select> <select data-a="dsel" data-f="type">${opts(T,draft.type)}</select>
<input id="dz" placeholder="المقاسات مفصولة بفاصلة: S, M, L, XL" value="${esc(draft.sizes)}"><textarea id="dd" rows="4" placeholder="وصف وتفاصيل المنتج">${esc(draft.desc)}</textarea>
<label style="display:block;margin-bottom:12px"><input type="checkbox" data-a="dout" ${draft.out?'checked':''} style="width:auto;margin:0 0 0 8px"> نفذت الكمية (يظهر للزباين ومش بيتباع)</label>
${draft.colors.map((c,k)=>`<div class="cr"><input type="color" data-a="dc" data-k="${k}" value="${esc(c.hex)}"><input data-a="dcn" data-k="${k}" placeholder="اسم اللون" value="${esc(c.name)}"><button class="x" data-a="dcr" data-k="${k}">✕</button></div>`).join('')}
<button class="btn" data-a="dca">+ لون</button><br><br><input id="di" type="file" accept="image/*" multiple><div class="th" style="flex-wrap:wrap">${draft.images.map((s,k)=>`<i style="width:64px;height:64px;position:relative;background-image:url(${s})"><b data-a="dimg" data-k="${k}" style="position:absolute;top:0;inset-inline-start:0;background:#000;color:#e66;padding:0 6px;cursor:pointer">✕</b></i>`).join('')}</div>
<button class="btn p blk" data-a="dadd">${ed?'حفظ التعديلات':'إضافة المنتج'}</button></div>`:''}
<h2>المنتجات (${S.products.length})</h2>${S.products.length?S.products.map(p=>`<div class="row"><div class="t" style="background-image:url(${p.images[0]||''})"></div><div class="g">${esc(p.name)}${p.out?' <span style="color:#e66">(نفذ)</span>':''}<div class="mut">${money(p.price)} · ${esc(label(p)||'بدون قسم')}<br>${(p.sizes||[]).map(esc).join(' ')} · ${(p.colors||[]).map(c=>esc(c.name)).join('، ')}</div></div><button class="btn" data-a="dedit" data-id="${p.id}" style="padding:6px 12px">تعديل</button> <button class="x" data-a="del" data-id="${p.id}">حذف</button></div>`).join(''):'<div class="empty">مفيش منتجات</div>'}
<p class="mut">التعديلات مش بتظهر للزباين غير بعد ما تضغط "تصدير الموقع" فوق.</p>`}
function dOrds(){const msg=dbState==='none'||dbState==='err'?'<div class="empty">الطلبات محتاجة تفتح الصفحة وانت مسجل دخول بحساب Claude بتاعك.</div>':'';
 return `<button class="btn p blk" data-a="oimp" style="margin-bottom:12px">${showImp?'إغلاق':'+ تسجيل طلب من الإيميل'}</button>
${showImp?`<div class="box" style="margin:0 0 20px"><p class="mut">الطلب بيوصلك على الإيميل. انسخ نص الإيميل كله والصقه هنا، والطلب هيتسجل بكل بياناته. (الطلبات بتتحفظ على الجهاز ده بس.)</p><textarea id="oi" rows="8" placeholder="الصق نص الطلب هنا"></textarea><button class="btn p blk" data-a="osave">حفظ الطلب</button></div>`:''}
${msg}${!msg&&!ORD.length?'<div class="empty">لسه مفيش طلبات مسجلة</div>':''}
${ORD.map(o=>`<div class="oc"><div class="oh"><b>${esc(o.name)}</b><span class="tag st-${esc(o.status)}">${ST[o.status]||''}</span></div>
<div class="mut">${new Date(o.ts).toLocaleString('ar-EG')} · ${money(o.total||0)}</div>
<div>📞 <a href="tel:${esc(o.phone)}" style="text-decoration:underline">${esc(o.phone)}</a> · 📍 ${esc(o.city||'-')}</div><div class="mut">🏠 ${esc(o.address)}</div>${o.pay?`<div class="mut">💳 ${esc(o.pay)}</div>`:''}${o.notes&&o.notes!=='-'?`<div class="mut">📝 ${esc(o.notes)}</div>`:''}
${(o.items||[]).map(i=>{const p=S.products.find(x=>x.id===i.code);return `<div class="it"><i style="background-image:url(${p?p.images[0]||'':''})"></i><span>${esc(i.name)}<br><span class="mut">${esc(i.color)} · × ${i.qty} · ${money(i.sum||0)}</span></span></div>`}).join('')}
<div class="of"><select data-a="ost" data-id="${o.id}">${opts(ST,o.status)}</select><button class="x" data-a="odel" data-id="${o.id}">حذف</button></div></div>`).join('')}`}
function dPay(){const p=S.pay;return `<h2>طرق الدفع</h2><label class="lb"><input type="checkbox" data-a="pcod" ${p.cod?'checked':''}> الدفع عند الاستلام</label>
${['vodafone','instapay','telda'].map(k=>{const m=p.m[k];return `<div class="oc"><div class="oh"><div>${badge(k)} <span class="mut">${PM[k].n}</span></div><label><input type="checkbox" data-a="pon" data-k="${k}" ${m.on?'checked':''} style="width:auto;margin:0 0 0 6px"> مفعّل</label></div>
<input data-a="pacc" data-k="${k}" placeholder="رقم المحفظة / اسم المستخدم" value="${esc(m.account)}"><input data-a="pnm" data-k="${k}" placeholder="اسم صاحب الحساب" value="${esc(m.name)}"><input data-a="piban" data-k="${k}" placeholder="رقم الحساب IBAN (اختياري)" dir="ltr" value="${esc(m.iban||'')}">
<div class="mut">شعار ${PM[k].n} (ارفع الشعار الرسمي بتاعهم)</div><input type="file" accept="image/*" data-a="plogo" data-k="${k}">${m.logo?`<button class="x" data-a="plogo_rm" data-k="${k}">مسح الشعار</button>`:''}<div class="mut" style="margin-top:8px">باركود التحويل QR (اختياري)</div><input type="file" accept="image/*" data-a="pqr" data-k="${k}">${m.qr?`<button class="x" data-a="pqr_rm" data-k="${k}">مسح الباركود</button>`:''}</div>`}).join('')}
<h2>واتساب (اختياري)</h2><input data-a="pwa" placeholder="رقم واتساب بصيغة 201xxxxxxxxx" value="${esc(p.whatsapp)}"><p class="mut">بعد أي تعديل اضغط "تصدير الموقع" فوق عشان يظهر للزباين.</p>`}
function dash(){const tabs=[['stats','📊','الإحصائيات'],['prods','📦','المنتجات'],['ords','🧾','الطلبات'],['pay','💳','الدفع']];
 return `<main><div class="dh"><h2 style="margin:0;color:var(--tx);font-size:18px">لوحة التحكم</h2><button class="btn p" data-a="pub">تصدير الموقع</button></div>
<nav class="dtabs">${tabs.map(([k,i,n])=>`<button class="${dtab===k?'on':''}" data-a="dtab" data-t="${k}"><span>${i}</span>${n}</button>`).join('')}</nav>
${dtab==='stats'?dStats():dtab==='prods'?dProds():dtab==='pay'?dPay():dOrds()}</main>`}
function shrink(f){return new Promise(r=>{const i=new Image,u=URL.createObjectURL(f);i.onload=()=>{const k=Math.min(1,700/Math.max(i.width,i.height)),c=document.createElement('canvas');c.width=i.width*k;c.height=i.height*k;c.getContext('2d').drawImage(i,0,0,c.width,c.height);URL.revokeObjectURL(u);r(c.toDataURL('image/jpeg',.72))};i.src=u})}
function syncDraft(){const g=i=>$(i);if(g('#dn'))draft.name=g('#dn').value;if(g('#dp'))draft.price=g('#dp').value;if(g('#dz'))draft.sizes=g('#dz').value;if(g('#dd'))draft.desc=g('#dd').value}
document.addEventListener('change',async e=>{const t=e.target,a=t.dataset.a;
 if(t.id==='di'){syncDraft();for(const f of t.files)draft.images.push(await shrink(f));render()}
 else if(a==='dc')draft.colors[t.dataset.k].hex=t.value;
 else if(a==='dsel')draft[t.dataset.f]=t.value;
 else if(a==='ost'){const o=ORD.find(x=>x.id===t.dataset.id);if(o){o.status=t.value;saveOrd();render()}}
 else if(a==='dout')draft.out=t.checked;
 else if(t.id==='rc'){const f=t.files[0];if(f){const r=await imgProc(f,1000,'image/jpeg',.7);receipt=r.url;receiptFile=r.file;render()}}
 else if(a==='pqr'){const f=t.files[0];if(f){S.pay.m[t.dataset.k].qr=(await imgProc(f,520,'image/jpeg',.88)).url;pp()}}
 else if(a==='pcod'){S.pay.cod=t.checked;pp()}
 else if(a==='pon'){S.pay.m[t.dataset.k].on=t.checked;pp()}
 else if(a==='plogo'){const f=t.files[0];if(f){S.pay.m[t.dataset.k].logo=(await imgProc(f,260,'image/png',1)).url;pp()}}
 else if(a==='sort'){sort=t.value;render()}});
document.addEventListener('input',e=>{const t=e.target,a2=t.dataset.a;if(a2==='pacc'){S.pay.m[t.dataset.k].account=t.value;try{persist()}catch(e){}}if(a2==='pnm'){S.pay.m[t.dataset.k].name=t.value;try{persist()}catch(e){}}if(a2==='piban'){S.pay.m[t.dataset.k].iban=t.value.replace(/\s/g,'');try{persist()}catch(e){}}if(a2==='pwa'){S.pay.whatsapp=t.value.trim();try{persist()}catch(e){}}if(t.dataset.a==='dcn')draft.colors[t.dataset.k].name=t.value;if(t.dataset.f&&!t.dataset.a)co[t.dataset.f]=t.value});
document.addEventListener('keydown',e=>{if(e.target.id==='q'&&e.key==='Enter'){nav('c/all/all',e.target.value.trim())}});
document.addEventListener('click',async e=>{const t=e.target.closest('[data-a]');if(!t)return;const d=t.dataset,a=d.a,P=id=>S.products.find(p=>p.id===id);
 if(a==='sc'){sel[d.id]=+d.k;render()}
 else if(a==='ss'){ssz[d.id]=+d.k;render()}
 else if(a==='im'){img[d.id]=+d.k;render()}
 else if(a==='add'){const p=P(d.id);if(p.out)return;const c=(p.colors||[])[sel[d.id]??0],z=(p.sizes||[])[ssz[d.id]??0],cn=(c?c.name:'-')+(z?' / '+z:''),x=cart.find(i=>i.id===p.id&&i.color===cn);
  x?x.qty++:cart.push({id:p.id,name:p.name,price:p.price,color:cn,qty:1,img:p.images[0]||''});save();render();t.textContent='تمت الإضافة ✓'}
 else if(a==='q'){const i=cart[d.k];i.qty+=+d.d;if(i.qty<1)cart.splice(d.k,1);save();render()}
 else if(a==='rm'){cart.splice(d.k,1);save();render()}
 else if(a==='order'){if(!co.n||!co.p||!co.a)return alert('من فضلك اكتب الاسم والموبايل والعنوان');if(!cart.length)return;
  if(pt==='cod')pm='cod';else{if(!pm)return alert('اختار المحفظة الأول');if(!receiptFile)return alert('من فضلك ارفق صورة التحويل')}
  const L=cart.map(i=>`- ${i.name} | اللون/المقاس: ${i.color} | الكمية: ${i.qty} | ${i.price*i.qty} ج.م | كود: ${i.id}`).join('\n'),payTxt=pm==='cod'?'الدفع عند الاستلام':PM[pm].n+' (صورة التحويل مرفقة)';
  const body=`طلب جديد - ${S.brand}\n\nالعميل: ${co.n}\nالموبايل: ${co.p}\nالمدينة: ${co.c||'-'}\nالعنوان: ${co.a}\nملاحظات: ${co.m||'-'}\nطريقة الدفع: ${payTxt}\n\nالمنتجات:\n${L}\n\nالإجمالي: ${total()} ج.م`;
  window._body=body;window._mail=`mailto:${S.email}?subject=${encodeURIComponent('طلب جديد - '+co.n)}&body=${encodeURIComponent(body)}`;window._file=receiptFile;window._rc=receipt;window._pm=pm;
  cart=[];save();receipt='';receiptFile=null;nav('done');
  if(window._file&&navigator.canShare&&navigator.canShare({files:[window._file]}))navigator.share({files:[window._file],title:'طلب جديد',text:body}).catch(()=>{});else location.href=window._mail}
 else if(a==='login'){if(await sha($('#lp').value)===S.pw){unlocked=true;try{sessionStorage.setItem('nx_u','1')}catch(e){}startOrders();render()}else alert('الباسورد غلط')}
 else if(a==='chpw'){const v=$('#np').value;if(v.length<6)return alert('6 حروف على الأقل');S.pw=await sha(v);alert('اتغير، اضغط تصدير الموقع')}
 else if(a==='dca'){syncDraft();draft.colors.push({name:'',hex:'#ffffff'});render()}
 else if(a==='dcr'){syncDraft();draft.colors.splice(d.k,1);render()}
 else if(a==='dadd'){syncDraft();if(!draft.name||!draft.price||!draft.images.length)return alert('اكتب الاسم والسعر وأضف صورة على الأقل');
  const pr=({id:editId||'p'+Date.now().toString(36),out:!!draft.out,name:draft.name,price:+draft.price,gender:draft.gender,type:draft.type,desc:draft.desc,sizes:draft.sizes.split(',').map(s=>s.trim()).filter(Boolean),colors:draft.colors.filter(c=>c.name),images:draft.images});const ix=S.products.findIndex(x=>x.id===pr.id);if(ix>=0)S.products[ix]=pr;else S.products.push(pr);editId=null;showForm=false;persist();
  draft={name:'',price:'',desc:'',sizes:'',gender:draft.gender,type:draft.type,colors:[{name:'أسود',hex:'#000000'}],images:[]};render()}
 else if(a==='del'){if(confirm('حذف المنتج؟')){S.products=S.products.filter(p=>p.id!==d.id);persist();render()}}
 else if(a==='dedit'){const p=P(d.id);draft={name:p.name,price:p.price,desc:p.desc||'',sizes:(p.sizes||[]).join(', '),gender:p.gender||'men',type:p.type||'hoodie',out:!!p.out,colors:(p.colors||[]).map(c=>({name:c.name,hex:c.hex})),images:p.images.slice()};editId=p.id;showForm=true;render();scrollTo(0,0)}
 else if(a==='dcancel'){editId=null;showForm=false;draft={name:'',price:'',desc:'',sizes:'',gender:'men',type:'hoodie',colors:[{name:'أسود',hex:'#000000'}],images:[]};render()}
 else if(a==='dimg'){syncDraft();draft.images.splice(+d.k,1);render()}
 else if(a==='pt'){pt=d.k;pm=pt==='cod'?'cod':'';render()}
 else if(a==='pm'){pm=d.k;render()}
 else if(a==='copy'){try{await navigator.clipboard.writeText(d.v);t.textContent='تم النسخ ✓'}catch(e){prompt('انسخ الرقم:',d.v)}}
 else if(a==='shr'){try{await navigator.share({files:[window._file],title:'طلب جديد',text:window._body})}catch(e){}}
 else if(a==='pqr_rm'){S.pay.m[d.k].qr='';pp()}
 else if(a==='plogo_rm'){S.pay.m[d.k].logo='';pp()}
 else if(a==='dtab'){dtab=d.t;render();scrollTo(0,0)}
 else if(a==='dform'){syncDraft();showForm=!showForm;render()}
 else if(a==='oimp'){showImp=!showImp;render()}
 else if(a==='osave'){const o=parseOrder($('#oi').value);if(!o)return alert('مش قادر أقرأ الطلب. انسخ نص الإيميل كامل، من "طلب جديد" لحد "الإجمالي"');
  o.id='o'+Date.now().toString(36);ORD.unshift(o);saveOrd();showImp=false;render()}
 else if(a==='odel'){if(confirm('حذف الطلب؟')){ORD=ORD.filter(x=>x.id!==d.id);saveOrd();render()}}
 else if(a==='pub'){S.ver=Date.now();persist();const c=document.documentElement.cloneNode(true);c.querySelector('#state').textContent=JSON.stringify(S).replace(/</g,'\\u003c');c.querySelector('#app').innerHTML='';
  const bl=new Blob(['<!DOCTYPE html>\n'+c.outerHTML],{type:'text/html'}),u=URL.createObjectURL(bl),x=document.createElement('a');x.href=u;x.download='index.html';document.body.appendChild(x);x.click();x.remove();setTimeout(()=>URL.revokeObjectURL(u),3000);
  alert('اتنزّل ملف index.html. ارفعه على Tiiny مكان القديم عشان التعديلات تظهر للزباين.')}
});
if(unlocked)startOrders();
render();
</script></body></html>
